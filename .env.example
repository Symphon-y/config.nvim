# Copy this file to .env and fill in values for this machine.
# .env is git-ignored — each machine has its own copy.
#
# NVIM_PROJECTS_DIR: base directory where local plugin repos live.
# When a plugin repo is found here, that copy is loaded instead of
# pulling from GitHub. If the path is absent, GitHub is used automatically.
# Default: ~/Projects
NVIM_PROJECTS_DIR=~/Projects
